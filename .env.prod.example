# Copie este arquivo para .env.prod e preencha os valores

# ─── Symfony ────────────────────────────────────────────────────────────────
APP_ENV=prod
APP_DEBUG=0
APP_SECRET=troque-por-uma-string-aleatoria-longa

# ─── Banco de dados remoto ───────────────────────────────────────────────────
DATABASE_URL="postgresql://usuario:senha@host-remoto:5432/nome-do-banco?serverVersion=16&charset=utf8"

# ─── JWT ────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=troque-pela-passphrase-da-sua-chave

# ─── Pusher ─────────────────────────────────────────────────────────────────
PUSHER_ENABLED=1
PUSHER_APP_ID=seu-app-id
PUSHER_APP_KEY=sua-app-key
PUSHER_APP_SECRET=seu-app-secret
PUSHER_APP_CLUSTER=sa1

# ─── Messenger ──────────────────────────────────────────────────────────────
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=1

# ─── CORS ───────────────────────────────────────────────────────────────────
# Ajuste para o domínio/IP da sua VPS
CORS_ALLOW_ORIGIN='^https?://(seu-dominio\.com)(:[0-9]+)?$'

# ─── MinIO ──────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=troque-por-senha-forte
MINIO_ENDPOINT=http://minio:9000
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=troque-por-senha-forte
MINIO_BUCKET=avatars
# URL pública que o BROWSER vai usar para acessar os arquivos
MINIO_PUBLIC_URL=http://ip-ou-dominio-da-vps:9000
