meta {
  name: Upload file
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/admin/files
  body: multipart-form
  auth: inherit
}

body:multipart-form {
  file: @file()
}

script:post-response {
  const resp = res.getBody()
  if (!resp.id) {
    throw new Error("fileId não veio na resposta")
  }
  bru.setVar("fileId", resp.id)
}

settings {
  encodeUrl: true
  timeout: 0
}
